import java.util.*;

class Edge {
    int u, v, weight;

    Edge(int u, int v, int w) {
        this.u = u;
        this.v = v;
        this.weight = w;
    }
}

public class BellmanFordDemo {

    static int[] bellmanFord(int n, List<Edge> edges, int source) {

        int[] dist = new int[n];
        Arrays.fill(dist, Integer.MAX_VALUE);
        dist[source] = 0;

        // V-1 relaxations
        for (int iter = 0; iter < n - 1; iter++) {

            for (Edge e : edges) {

                if (dist[e.u] != Integer.MAX_VALUE &&
                    dist[e.u] + e.weight < dist[e.v]) {

                    dist[e.v] = dist[e.u] + e.weight;
                }
            }
        }

        // Negative cycle detection
        for (Edge e : edges) {

            if (dist[e.u] != Integer.MAX_VALUE &&
                dist[e.u] + e.weight < dist[e.v]) {

                throw new RuntimeException(
                    "Negative cycle reachable from source");
            }
        }

        return dist;
    }

    public static void main(String[] args) {

        int V = 7;

        List<Edge> edges = new ArrayList<>();

        // Example BMTC routes
        edges.add(new Edge(0, 1, 8));   // MJC -> KEM
        edges.add(new Edge(0, 2, 5));   // MJC -> JAY
        edges.add(new Edge(1, 3, 12));  // KEM -> KOR
        edges.add(new Edge(2, 3, 7));   // JAY -> KOR
        edges.add(new Edge(3, 4, 10));  // KOR -> WHF
        edges.add(new Edge(3, 5, 4));   // KOR -> HBR
        edges.add(new Edge(5, 6, 6));   // HBR -> MRT
        edges.add(new Edge(4, 6, -3));  // WHF -> MRT

        int[] dist = bellmanFord(V, edges, 0);

        System.out.println("Shortest distances from MJC:");

        for (int d : dist)
            System.out.print(d + " ");
    }
}
